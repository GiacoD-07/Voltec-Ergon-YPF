# Copiar este archivo a ".env" y ajustar los valores si es necesario

# Entorno
# produccion -> prod
# desarrollo -> dev
APP_ENV=dev

# Configuración de la base de datos

# Motor de base de datos: mysql o pgsql
DB_DRIVER=mysql

DB_HOST=localhost

# Puertos por defecto:
# mysql = 3306
# pgsql = 5432
DB_PORT=3306

DB_NAME=ypf_energia
DB_USER=root
DB_PASS=root

# Clave requerida para las peticiones POST de la API
API_KEY=cambia-esta-clave-por-una-larga

# Huella de carbono: kg de CO2 equivalente por kWh consumido.
# Valor de referencia usado para Argentina; ajustalo si tu proveedor publica otro factor.
CO2_EMISSION_FACTOR_KG_PER_KWH=0.39
